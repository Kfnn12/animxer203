{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ajax/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/AnikotoTheme/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/anikoto/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/watch/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
