{
  "version": 2,
  "rewrites": [
    {
      "source": "/ajax/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/AnikotoTheme/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/anikoto/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/watch/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|api/|ajax/|AnikotoTheme/|images/|anikoto/|watch/|vite\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
