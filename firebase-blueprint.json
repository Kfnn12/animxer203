{
  "entities": {
    "Comment": {
      "title": "Comment",
      "description": "A comment on an anime episode",
      "type": "object",
      "properties": {
        "episodeId": { "type": "string", "description": "The identifier of the episode" },
        "userId": { "type": "string", "description": "The UID of the user who posted the comment" },
        "userDisplayName": { "type": "string", "description": "The display name of the user" },
        "text": { "type": "string", "description": "The comment text" },
        "createdAt": { "type": "timestamp", "description": "When the comment was created" },
        "updatedAt": { "type": "timestamp", "description": "When the comment was last updated" }
      },
      "required": ["episodeId", "userId", "userDisplayName", "text", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "comments/{commentId}": {
      "schema": { "$ref": "Comment" },
      "description": "Stores episode comments globally"
    }
  }
}
